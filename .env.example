# Copy to .env and fill in. The .env file is ignored by git.

# Postgres on Supabase: project URL and the server-side secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# The key callers must send in the X-API-Key header.
# Generate one with: openssl rand -hex 32
BANK_API_KEY=

# Public address of this API, used to build links.
PUBLIC_BASE_URL=http://localhost:8000

# Optional: an inbox you control. The seed script gives it to the demo customer.
DEMO_CUSTOMER_EMAIL=
