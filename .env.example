# Copy to .env and fill in. The .env file is ignored by git.

# Postgres on Supabase: project URL and the server-side secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Postgres connection string. Only used to apply the schema:
#   psql "$SUPABASE_DB_URL" -f db/schema.sql
SUPABASE_DB_URL=

# The key callers must send in the X-API-Key header.
# Generate one with: openssl rand -hex 32
BANK_API_KEY=

# Public address of this API, used to build links.
PUBLIC_BASE_URL=http://localhost:8000

# Optional: an inbox you control. The seed script gives it to the demo customer.
DEMO_CUSTOMER_EMAIL=

# Seconds the transactions endpoint waits before answering, to imitate a legacy system.
TRANSACTIONS_DELAY_SECONDS=1.0

# Optional: a Resend API key. Without it proposals are stored but no email is sent.
RESEND_API_KEY=
EMAIL_FROM="Banco Magallanes <onboarding@resend.dev>"

# Secret the seed script derives each customer's app PIN from, so no PIN is in the code.
# Generate one with: openssl rand -hex 32. Print the PINs with: python scripts/seed.py --pins
APP_PIN_SECRET=
# Document number of the customer whose app opens at /app when the link names nobody.
DEMO_APP_DOCUMENT=314159268

# Optional: a Telegram bot token. Without it no message is sent to the customer's chat.
TELEGRAM_BOT_TOKEN=
# Optional: the chat that receives the demo customer's messages. Used by the seed script.
DEMO_TELEGRAM_CHAT_ID=

# true once the contact center has a phone line a call can be transferred to.
HUMAN_LINE_ATTACHED=false
