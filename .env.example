# Copy to .env and fill in. The .env file is ignored by git. Never commit real values.

# Required: the Supabase project URL (https://<project>.supabase.co).
SUPABASE_URL=
# Required: the server-side secret key of that project. Never the publishable key.
SUPABASE_SECRET_KEY=
# Postgres connection string. Only used to apply the schema: psql "$SUPABASE_DB_URL" -f db/schema.sql
SUPABASE_DB_URL=
# Required: the key callers send in the X-API-Key header. Generate: openssl rand -hex 32
BANK_API_KEY=
# Required: the secret the seed script derives each app PIN from. Generate: openssl rand -hex 32
APP_PIN_SECRET=

# Public address of this API, used to build the links sent to customers.
PUBLIC_BASE_URL=http://localhost:8000
# Seconds the transactions endpoint waits before answering, to imitate a legacy system.
TRANSACTIONS_DELAY_SECONDS=1.0

# Optional: a Resend API key. Without it proposals are stored but no email is sent.
RESEND_API_KEY=
# The sender shown on those emails.
EMAIL_FROM="Banco Magallanes <onboarding@resend.dev>"
# Optional: a Telegram bot token. Without it no message is sent to the customer's chat.
TELEGRAM_BOT_TOKEN=

# Optional: an inbox you control. The seed script gives it to the demo customers.
DEMO_CUSTOMER_EMAIL=
# Optional: the Telegram chat that receives the demo customers' messages. Used by the seed script.
DEMO_TELEGRAM_CHAT_ID=
# Optional: the phone you call from (+56...). The seed script puts it on file for the first demo customer.
DEMO_CUSTOMER_PHONE=

# Optional: the bank's phone line as the sign-in screen shows it (+1 555 010 0100). Empty: not shown.
BANK_PHONE_LINE=
# true once the contact center has a phone line a call can be transferred to.
HUMAN_LINE_ATTACHED=false
# Optional: embed snippet of the conversation widget. {variables}, {customer} and {lang} are filled in.
ASSISTANT_EMBED_HTML=

# Optional: the Salesforce org the insurance sale is mirrored to. Empty: nothing is mirrored.
SALESFORCE_INSTANCE_URL=
# Optional: client id of the External Client App (OAuth 2.0 client credentials flow).
SALESFORCE_CLIENT_ID=
# Optional: client secret of the same app.
SALESFORCE_CLIENT_SECRET=
# The Salesforce API version the requests use.
SALESFORCE_API_VERSION=v65.0
